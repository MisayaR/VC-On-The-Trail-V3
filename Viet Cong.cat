          <selectionEntries>
            <selectionEntry name="Victory Banner" id="3462-1f21-cbfa-a303" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="db2b-8f29-29bf-925c" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
                <constraint id="e991-72fe-7d54-519e" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Victory Banner" id="34a2-c8c2-916f-baa9" hidden="false" typeId="bd89-e167-3562-59e1" typeName="Ability">
                  <characteristics>
                    <characteristic name="Description" typeId="ca19-85ed-345c-a38d">Any Infantry or Artillery unit within 12” and line of sight to The Victory Banner adds +1 to its morale value. Only one Victory Banner may be included in a force. A model equipped with the Victory Banner exchanges all of their weapons for a pistol</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Signal Bugle" id="0488-837c-302c-70a6" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="bf06-f40a-743b-033f" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
                <constraint id="0eba-d896-a5c0-1396" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Signal Bugle" id="7bbb-6046-7f83-34c3" hidden="false" typeId="bd89-e167-3562-59e1" typeName="Ability">
                  <characteristics>
                    <characteristic name="Description" typeId="ca19-85ed-345c-a38d">All inexperienced units within 36” of the model with a signal bugle, without line of sight, suffers a -1 to morale. Cannot be carried by officers.</characteristic>
